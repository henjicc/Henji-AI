  {
    "id": "review-remaining-modelscope-custom",
    "surface": "生成",
    "name": "核对-魔搭自定义模型多条与删除确认（5.8 补截，校验接口走本机替身）",
    "checklist": [
      "G17.3",
      "A15.3"
    ],
    "writesUserData": true,
    "steps": [
      {
        "enter": "generation"
      },
      {
        "selectModel": {
          "modelId": "modelscope-custom",
          "providerId": "modelscope"
        }
      },
      {
        "stubIpc": {
          "channel": "http:fetch",
          "mode": "resolve",
          "data": {
            "status": 200,
            "statusText": "OK",
            "headers": [
              [
                "content-type",
                "application/json"
              ]
            ],
            "body": "{\"Data\": {\"Providers\": [{\"CostTier\": \"Free\", \"EstimatedMagicGrainCost\": 0}], \"TotalCount\": 1}, \"Success\": true}"
          }
        }
      },
      {
        "click": {
          "selector": "[data-param-id=\"modelscopeCustomModel\"] [data-panel-trigger-button]"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "添加新模型"
        }
      },
      {
        "fill": {
          "target": {
            "placeholder": "例如：Tongyi-MAI/Z-Image-Turbo"
          },
          "text": "Review/Custom-Image-A"
        }
      },
      {
        "fill": {
          "target": {
            "placeholder": "例如：Z-Image Turbo"
          },
          "text": "核对模型 A"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "确认添加"
        }
      },
      {
        "waitFor": {
          "text": "核对模型 A"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "添加新模型"
        }
      },
      {
        "fill": {
          "target": {
            "placeholder": "例如：Tongyi-MAI/Z-Image-Turbo"
          },
          "text": "Review/Custom-Image-B"
        }
      },
      {
        "fill": {
          "target": {
            "placeholder": "例如：Z-Image Turbo"
          },
          "text": "核对模型 B"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "确认添加"
        }
      },
      {
        "waitFor": {
          "text": "核对模型 B"
        }
      },
      {
        "capture": "custom-models-list"
      },
      {
        "click": {
          "role": "button",
          "name": "删除",
          "exact": true
        }
      },
      {
        "waitFor": {
          "role": "alertdialog"
        }
      },
      {
        "wait": 400
      },
      {
        "capture": "custom-model-delete-confirm"
      },
      {
        "click": {
          "role": "button",
          "name": "删除",
          "exact": true,
          "within": {
            "role": "alertdialog"
          }
        }
      },
      {
        "waitFor": {
          "target": {
            "role": "alertdialog"
          },
          "state": "hidden"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "删除",
          "exact": true
        }
      },
      {
        "click": {
          "role": "button",
          "name": "删除",
          "exact": true,
          "within": {
            "role": "alertdialog"
          }
        }
      },
      {
        "waitFor": {
          "text": "暂无自定义模型"
        }
      },
      {
        "escape": {}
      }
