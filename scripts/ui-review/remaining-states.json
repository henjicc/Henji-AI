  {
    "id": "review-remaining-asset-missing",
    "surface": "资产库",
    "name": "核对-资产预览源文件丢失（5.8 补截）",
    "checklist": [
      "A06.4"
    ],
    "writesUserData": true,
    "expectedLogEvents": [
      "asset.inspect.failed"
    ],
    "expectedBrowserErrors": [
      "status of 404"
    ],
    "steps": [
      {
        "seedAsset": {
          "name": "预览失败验收",
          "missing": true
        }
      },
      {
        "reload": {}
      },
      {
        "enter": "assets"
      },
      {
        "doubleClick": {
          "selector": "[data-asset-id]",
          "at": {
            "x": 120,
            "y": 60
          }
        }
      },
      {
        "wait": 800
      },
      {
        "capture": "asset-preview-missing"
      },
      {
        "escape": {}
      }
    ]
  },
  {
    "id": "review-remaining-data-path",
    "surface": "设置",
    "name": "核对-数据目录迁移进度与失败（5.8 补截，复制文件通道挂起后拒绝）",
    "checklist": [
      "A09.2",
      "A09.3",
      "A07.5"
    ],
    "writesUserData": true,
    "expectedLogEvents": [
      "data_path.migration.copy_failed",
      "data_path.migration.aborted",
      "data_path.migration.failed"
    ],
    "steps": [
      {
        "enter": {
          "surface": "settings.storage"
        }
      },
      {
        "stubDialogs": {
          "save": false,
          "open": [
            "@tmp:data-path-target"
          ]
        }
      },
      {
        "stubIpc": {
          "channel": "fs:copyFile",
          "mode": "hold"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "选择",
          "exact": true
        }
      },
      {
        "waitFor": {
          "text": "正在迁移数据..."
        }
      },
      {
        "wait": 400
      },
      {
        "capture": "migration-progress"
      },
      {
        "stubIpc": {
          "channel": "fs:copyFile",
          "mode": "reject",
          "message": "目标磁盘空间不足"
        }
      },
      {
        "releaseIpc": {
          "channel": "fs:copyFile",
          "release": "reject",
          "message": "目标磁盘空间不足"
        }
      },
      {
        "waitFor": {
          "text": "/数据迁移失败/"
        }
      },
      {
        "waitFor": {
          "target": {
            "text": "正在迁移数据..."
          },
          "state": "hidden"
        }
      },
      {
        "capture": "migration-failed"
      },
      {
        "click": {
          "role": "button",
          "name": "确定",
          "exact": true
        }
      }
    ]
  },
  {
