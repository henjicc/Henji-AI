{
  "id": "review-quick-mark-viewer",
  "surface": "生成",
  "name": "核对-生成工作区上传图 → 查看器 → 编辑（打开完整图片编辑器；箭头与文字标注由“图片编辑 V3 标注”场景核对）",
  "checklist": [
    "T08.1"
  ],
  "writesUserData": true,
  "steps": [
    {
      "enter": "generation"
    },
    {
      "selectModel": {
        "modelId": "kie-nano-banana-2",
        "providerId": "kie",
        "search": "Nano Banana 2"
      }
    },
    {
      "waitStable": {
        "target": {
          "role": "button",
          "name": "/^模型：/"
        }
      }
    },
    {
      "setFiles": {
        "target": {
          "selector": "input[type=\"file\"][accept*=\"image\"]"
        },
        "files": [
          "resources/icons/icon.png"
        ]
      }
    },
    {
      "waitFor": {
        "selector": "img[alt=\"参考 1\"]"
      },
      "timeout": 10000
    },
    {
      "click": {
        "selector": "img[alt=\"参考 1\"]"
      }
    },
    {
      "waitFor": {
        "role": "dialog",
        "name": "图片"
      },
      "timeout": 10000
    },
    {
      "waitStable": {}
    },
    {
      "capture": "viewer"
    },
    {
      "click": {
        "role": "button",
        "name": "编辑",
        "exact": true,
        "within": {
          "role": "dialog",
          "name": "图片"
        }
      }
    },
    {
      "waitFor": {
        "selector": "[data-document-transparency-grid]"
      },
      "timeout": 15000
    },
    {
      "wait": 800
    },
    {
      "waitStable": {}
    },
    {
      "capture": "editor-rest"
    },
    {
      "click": {
        "role": "button",
        "name": "关闭",
        "exact": true,
        "within": {
          "selector": "[data-command-bar]"
        }
      },
      "ifPresent": {
        "selector": "[data-command-bar] button",
        "hasText": "关闭"
      }
    },
    {
      "escape": {}
    }
  ]
}
