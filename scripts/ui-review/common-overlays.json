  {
    "id": "review-common-name-dialogs",
    "surface": "通用",
    "name": "核对-新建/重命名弹窗与删除确认（画布工程列表）",
    "checklist": [
      "U07.1",
      "U07.2",
      "U07.3",
      "U03.2"
    ],
    "writesUserData": true,
    "steps": [
      {
        "seedCanvas": {
          "nodes": [
            {
              "id": "__review_common_text",
              "type": "stringSourceNode",
              "position": {
                "x": 0,
                "y": 0
              },
              "width": 240,
              "height": 96,
              "data": {
                "displayName": "通用弹窗核对",
                "value": "工程列表夹具"
              }
            }
          ],
          "edges": [],
          "viewport": {
            "x": 320,
            "y": 60,
            "zoom": 0.8
          }
        }
      },
      {
        "click": {
          "role": "button",
          "name": "/返回项目|Back to Projects/"
        }
      },
      {
        "waitFor": {
          "selector": "[data-project-id]"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "/^新建/"
        }
      },
      {
        "waitFor": {
          "role": "dialog"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "create-open"
      },
      {
        "fill": {
          "target": {
            "role": "textbox",
            "within": {
              "role": "dialog"
            }
          },
          "text": ""
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "create-empty"
      },
      {
        "fill": {
          "target": {
            "role": "textbox",
            "within": {
              "role": "dialog"
            }
          },
          "text": "一个名字非常非常长的画布工程用来检查弹窗里的输入框与按钮在长文本下是否还能对齐和完整显示"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "create-long"
      },
      {
        "press": "Escape"
      },
      {
        "waitFor": {
          "target": {
            "role": "dialog"
          },
          "state": "hidden"
        }
      },
      {
        "rightClick": {
          "selector": "[data-project-id]"
        }
      },
      {
        "waitFor": {
          "role": "menu"
        }
      },
      {
        "click": {
          "role": "menuitem",
          "name": "/删除/"
        }
      },
      {
        "waitFor": {
          "role": "dialog"
        }
      },
      {
        "hover": {
          "role": "button",
