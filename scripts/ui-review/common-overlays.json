  {
    "id": "review-common-text-menu",
    "surface": "通用",
    "name": "核对-全局文本右键菜单（打开、悬停项、禁用项）",
    "checklist": [
      "U04.1",
      "U04.2",
      "U04.3",
      "U04.4"
    ],
    "steps": [
      {
        "enter": "generation"
      },
      {
        "click": {
          "role": "button",
          "name": "搜索历史"
        }
      },
      {
        "rightClick": {
          "placeholder": "搜索提示词、模型或错误信息"
        }
      },
      {
        "waitFor": {
          "role": "menu"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "text-menu"
      },
      {
        "hover": {
          "role": "menuitem",
          "nth": "last"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "text-menu-hover"
      },
      {
        "press": "Escape"
      },
      {
        "waitFor": {
          "target": {
            "role": "menu"
          },
          "state": "hidden"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "搜索历史"
        },
        "optional": true
      }
    ]
  },
  {
    "id": "review-common-media",
    "surface": "通用",
    "name": "核对-成功通知、结果菜单、图片与视频查看器、音频迷你条（生成记录夹具）",
    "checklist": [
      "U02.1",
      "U04.1",
      "U09.1",
      "U09.2",
      "U09.4",
      "U09.7",
      "U10.1",
      "U10.2",
      "U10.3",
      "U11.3"
    ],
    "writesUserData": true,
    "steps": [
      {
        "enter": "generation"
      },
      {
        "escape": {}
      },
      {
        "seedHistory": {
          "rows": [
            {
              "id": "audio",
              "type": "audio",
              "prompt": "欢迎来到痕迹AI，今天我们来聊一聊通用查看器。"
            },
            {
              "id": "video",
              "type": "video",
              "prompt": "海浪拍打礁石的慢镜头"
            },
            {
              "id": "multi",
              "type": "image",
              "file": "images",
              "prompt": "同一角色的四个表情：开心、惊讶、生气、困倦"
            },
            {
              "id": "single",
              "type": "image",
              "prompt": "一只橘猫趴在窗台上晒太阳，柔和的午后光线"
            }
          ]
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "seeded"
      },
      {
        "rightClick": {
          "selector": "[data-generation-task-id=\"__review_common_single\"] [data-generation-result]"
        }
      },
      {
        "waitFor": {
          "role": "menu"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "result-menu"
      },
      {
        "click": {
          "role": "menuitem",
          "name": "添加到资产库"
        }
      },
      {
        "waitFor": {
          "role": "status",
          "hasText": "/资产/"
        },
        "optional": true
      },
      {
        "waitFor": {
          "target": {
            "role": "menu"
          },
          "state": "hidden"
        }
      },
      {
        "wait": 300
      },
      {
        "capture": "toast-success"
      },
      {
        "waitFor": {
          "target": {
            "role": "status",
            "hasText": "/资产/"
          },
          "state": "hidden"
        },
        "timeout": 6000,
        "optional": true
      },
      {
        "click": {
          "selector": "[data-generation-task-id=\"__review_common_single\"] [data-generation-result]"
        }
      },
      {
        "waitFor": {
          "selector": "[data-image-viewer=\"true\"]"
        }
      },
      {
        "waitStable": {
          "target": {
            "selector": "[data-image-viewer=\"true\"] img"
          }
        }
      },
      {
        "capture": "image-viewer"
      },
      {
        "scroll": {
          "target": {
            "selector": "[data-image-viewer=\"true\"] img"
          },
          "dy": -600
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "image-zoom"
      },
      {
        "click": {
          "role": "button",
          "name": "/图片信息/"
        },
        "optional": true
      },
      {
        "waitStable": {}
      },
      {
        "capture": "image-info"
      },
      {
        "press": "Escape"
      },
      {
        "waitFor": {
          "target": {
            "selector": "[data-image-viewer=\"true\"]"
          },
          "state": "hidden"
        }
      },
      {
        "click": {
          "selector": "[data-generation-task-id=\"__review_common_multi\"] [data-generation-result]",
          "nth": 1
        }
      },
      {
        "waitFor": {
          "selector": "[data-image-viewer=\"true\"]"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "image-viewer-multi"
      },
      {
        "press": "Escape"
      },
      {
        "waitFor": {
          "target": {
            "selector": "[data-image-viewer=\"true\"]"
          },
          "state": "hidden"
        }
      },
      {
        "click": {
          "selector": "[data-generation-task-id=\"__review_common_video\"] video"
        }
      },
      {
        "waitFor": {
          "role": "button",
          "name": "播放速度"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "video-viewer"
      },
      {
        "open": {
          "trigger": {
            "role": "button",
            "name": "播放速度"
          }
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "video-speed-menu"
      },
      {
        "press": "Escape"
      },
      {
        "hover": {
          "role": "slider",
          "name": "音量"
        },
        "optional": true
      },
      {
        "capture": "video-volume"
      },
      {
        "press": "Escape"
      }
    ]
  },
