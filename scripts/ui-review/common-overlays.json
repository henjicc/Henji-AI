[
  {
    "id": "review-common-titlebar",
    "surface": "通用",
    "name": "核对-标题栏、工作区导航、窗口控件与悬停说明",
    "checklist": [
      "U01.1",
      "U01.2",
      "U01.3",
      "U01.4",
      "U01.6",
      "U05.1",
      "U05.3"
    ],
    "steps": [
      {
        "enter": "generation"
      },
      {
        "hover": {
          "role": "banner"
        },
        "optional": true
      },
      {
        "waitStable": {}
      },
      {
        "capture": "rest"
      },
      {
        "hover": {
          "role": "button",
          "name": "/^(画布|Canvas)$/"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "nav-hover"
      },
      {
        "focus": {
          "role": "button",
          "name": "/^(生成|Generation)$/"
        }
      },
      {
        "waitStable": {}
      },
      {
        "capture": "nav-focus"
      },
      {
        "hover": {
          "role": "button",
          "name": "设置",
