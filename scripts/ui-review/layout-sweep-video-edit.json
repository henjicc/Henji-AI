{
  "id": "sweep-video-edit",
  "surface": "剪辑",
  "name": "尺寸扫描-剪辑（压力数据；每个面板与检查器标签逐档压到最小，窗口逐档缩小）",
  "writesUserData": true,
  "steps": [
    { "enter": { "surface": "workspace.video_edit" } },
    { "click": { "role": "button", "name": "关闭项目" }, "ifPresent": { "role": "button", "name": "关闭项目" } },
    { "waitFor": { "role": "button", "name": "/^新建项目$/" }, "timeout": 12000 },
    { "seedVideoEdit": { "name": "扫描-剪辑", "captions": 6, "effects": true, "motion": true, "stress": true } },
    { "waitFor": { "selector": "canvas[aria-label=\"剪辑画面\"][data-presented-frame]" }, "timeout": 30000 },
    { "click": { "selector": "[data-video-edit-clip$=\"-picture\"]", "at": { "x": 30, "y": 12 } }, "optional": true },
    { "waitStable": {} },
    { "capture": "start" },
    { "sweepLayout": { "name": "dock", "windows": ["1280x800", "1100x720", "960x640"] } },

    { "click": { "role": "button", "name": "展开视频 1关键帧" }, "optional": true },
    { "waitStable": {} },
    { "capture": "keyframes" },
    { "sweepLayout": { "name": "keyframes", "maxSteps": 6 } },
    { "click": { "role": "radio", "name": "速度曲线" }, "optional": true },
    { "waitStable": {} },
    { "sweepLayout": { "name": "curve", "maxSteps": 6 } },
    { "click": { "role": "button", "name": "收起视频 1关键帧" }, "optional": true },

    { "click": { "selector": ".dv-tab", "hasText": "预设" }, "optional": true },
    { "waitStable": {} },
    { "capture": "presets" },
    { "sweepLayout": { "name": "presets", "maxSteps": 6 } },
    { "click": { "selector": ".dv-tab", "hasText": "/^效果$/" }, "optional": true },
    { "waitStable": {} },
    { "capture": "effects-library" },
    { "sweepLayout": { "name": "library", "maxSteps": 6 } },
    { "click": { "selector": ".dv-tab", "hasText": "模板" }, "optional": true },
    { "waitStable": {} },
    { "capture": "templates" },
    { "sweepLayout": { "name": "templates", "maxSteps": 6 } },
    { "click": { "selector": ".dv-tab", "hasText": "风格" }, "optional": true },
    { "waitStable": {} },
    { "capture": "style-kits" },
    { "sweepLayout": { "name": "style", "maxSteps": 6 } },

    { "open": { "trigger": { "role": "menuitem", "name": "窗口" }, "expect": { "role": "menu" } }, "optional": true },
    { "click": { "role": "menuitemcheckbox", "name": "/字幕与标记/" }, "optional": true },
    { "waitStable": {} },
    { "capture": "content" },
    { "sweepLayout": { "name": "content", "maxSteps": 6 } },
    { "open": { "trigger": { "role": "menuitem", "name": "窗口" }, "expect": { "role": "menu" } }, "optional": true },
    { "click": { "role": "menuitemcheckbox", "name": "/批注/" }, "optional": true },
    { "waitStable": {} },
    { "capture": "annotations" },
    { "sweepLayout": { "name": "annotations", "maxSteps": 6 } },
    { "open": { "trigger": { "role": "menuitem", "name": "窗口" }, "expect": { "role": "menu" } }, "optional": true },
    { "click": { "role": "menuitemcheckbox", "name": "/全能调色/" }, "optional": true },
    { "waitStable": {} },
    { "capture": "color-grade" },
    { "sweepLayout": { "name": "grade", "maxSteps": 6 } },
    { "open": { "trigger": { "role": "menuitem", "name": "窗口" }, "expect": { "role": "menu" } }, "optional": true },
    { "click": { "role": "menuitemcheckbox", "name": "/跟踪/" }, "optional": true },
    { "waitStable": {} },
    { "capture": "tracking" },
    { "sweepLayout": { "name": "tracking", "maxSteps": 6 } },
    { "open": { "trigger": { "role": "menuitem", "name": "窗口" }, "expect": { "role": "menu" } }, "optional": true },
    { "click": { "role": "menuitemcheckbox", "name": "/^代码/" }, "optional": true },
    { "waitStable": {} },
    { "capture": "code-project" },
    { "sweepLayout": { "name": "code", "maxSteps": 6 } },
    { "open": { "trigger": { "role": "menuitem", "name": "窗口" }, "expect": { "role": "menu" } }, "optional": true },
    { "click": { "role": "menuitemcheckbox", "name": "/源监视器/" }, "optional": true },
    { "waitStable": {} },
    { "capture": "source" },
    { "sweepLayout": { "name": "source", "maxSteps": 6 } }
  ]
}
