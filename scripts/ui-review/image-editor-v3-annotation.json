{
  "id": "review-image-editor-v3-annotation",
  "surface": "工具箱",
  "name": "核对-图片编辑 V3 标注：矢量箭头与文字（工具组浮层、绘制、文字输入面板）",
  "checklist": [
    "T08"
  ],
  "writesUserData": true,
  "steps": [
    {
      "enter": {
        "surface": "tool.image_edit",
        "media": "resources/icons/icon.png"
      }
    },
    {
      "waitFor": {
        "selector": "[data-document-transparency-grid]"
      },
      "timeout": 30000
    },
    {
      "wait": 1200
    },
    {
      "waitStable": {}
    },
    {
      "capture": "rest"
    },
    {
      "open": {
        "trigger": {
          "selector": "[data-tool-id=\"vector\"]"
        },
        "expect": {
          "role": "menuitem",
          "name": "/^(箭头|Arrow)$/i"
        }
      }
    },
    {
      "waitStable": {}
    },
    {
      "capture": "vector-group"
    },
    {
      "click": {
        "role": "menuitem",
        "name": "/^(箭头|Arrow)$/i"
      }
    },
    {
      "drag": {
        "from": {
          "selector": "[data-vector-overlay]",
          "at": {
            "x": 80,
            "y": 100
          }
        },
        "to": {
          "dx": 220,
          "dy": 0
        },
        "steps": 12
      }
    },
    {
      "waitStable": {}
    },
    {
      "capture": "arrow-drawn"
    },
    {
      "open": {
        "trigger": {
          "selector": "[data-tool-id=\"vector\"]"
        },
        "expect": {
          "role": "menuitem",
          "name": "/^(文字|Text)$/i"
        }
      }
    },
    {
      "click": {
        "role": "menuitem",
        "name": "/^(文字|Text)$/i"
      }
    },
    {
      "click": {
        "selector": "[data-vector-overlay]",
        "at": {
          "x": 100,
          "y": 330
        }
      }
    },
    {
      "waitFor": {
        "role": "textbox",
        "name": "文字内容"
      },
      "timeout": 5000
    },
    {
      "fill": {
        "target": {
          "role": "textbox",
          "name": "文字内容"
        },
        "text": "V3 原位文字"
      }
    },
    {
      "waitStable": {}
    },
    {
      "capture": "text-inline"
    },
    {
      "escape": {}
    }
  ]
}
