        "ifPresent": {
          "selector": "[data-more-params-trigger]"
        }
      },
      {
        "open": {
          "trigger": {
            "selector": "[data-param-id=\"minimaxVoiceClonePanel\"] [data-panel-trigger-button]"
          }
        }
      },
      {
        "fill": {
          "target": {
            "placeholder": "必填，用于保存到音色库"
          },
          "text": "核对-新克隆音色"
        }
      },
      {
        "fill": {
          "target": {
            "placeholder": "输入用于试听合成的文本"
          },
          "text": "你好，这是一段克隆试听。"
        }
      },
      {
        "setFiles": {
          "target": {
            "selector": "[data-panel-scroll-region] input[type=\"file\"]",
            "nth": 0
          },
          "files": [
            "@generated:audio:12"
          ]
        },
        "optional": true
      },
      {
        "stubIpc": {
          "channel": "ai:getRuntimeProviderKeyStatus",
          "mode": "resolve",
          "shape": "envelope",
          "data": [
            {
              "providerId": "ppio",
              "configured": true
            }
          ]
        }
      },
      {
        "stubIpc": {
          "channel": "ai:generate",
          "mode": "hold",
          "shape": "envelope"
        }
      },
      {
        "click": {
          "role": "button",
          "name": "开始克隆"
        }
      },
      {
        "waitFor": {
          "role": "button",
          "name": "克隆中..."
        },
        "timeout": 12000
      },
      {
        "capture": "voice-clone-running"
      },
      {
        "releaseIpc": {
          "channel": "ai:generate",
          "release": "reject",
          "shape": "envelope",
          "message": "核对夹具：供应商返回音频时长不足 10 秒，请换一段更长的样本。"
        }
      },
      {
        "waitFor": {
          "role": "alert"
        },
        "timeout": 12000
      },
      {
        "waitStable": {}
      },
      {
        "capture": "voice-clone-failed"
      }
