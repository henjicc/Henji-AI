+// Henji-AI: keep the source store synchronous. Only React's view notifications
+// during rectangle selection are coalesced; ending selection flushes immediately.
+const selectionStores = new WeakMap();
+const connectionStores = new WeakMap();
+
+export function getSelectionViewStore(store) {
+    let view = selectionStores.get(store);
+    if (view) return view;
+    const listeners = new Set();
+    let stop, queued = false, epoch = 0, previous;
+    view = { ...store, subscribe(listener) {
+        const notify = (state, before) => listener(state, before);
+        listeners.add(notify);
+        if (!stop) stop = store.subscribe((state, before) => {
+            if (!state.userSelectionActive) {
+                epoch++;
+                queued = false;
+                previous = undefined;
+                listeners.forEach(notify => notify(state, before));
+                return;
+            }
+            if (queued) return;
+            previous = before;
+            queued = true;
+            const ticket = epoch;
+            queueMicrotask(() => {
+                if (ticket !== epoch) return;
+                queued = false;
+                const beforeBatch = previous;
+                previous = undefined;
+                const state = store.getState();
+                listeners.forEach(notify => notify(state, beforeBatch));
+            });
+        });
+        return () => {
+            if (!listeners.delete(notify) || listeners.size) return;
+            stop?.();
+            stop = undefined;
+            epoch++;
+            queued = false;
+            previous = undefined;
+        };
+    } };
+    selectionStores.set(store, view);
+    return view;
+}
+
+// connectingSelector reads exactly these three fields. Share their subscription
+// across Handles without deferring connection feedback or retaining graph data.
+export function getHandleConnectionStore(store) {
+    let view = connectionStores.get(store);
+    if (view) return view;
+    const listeners = new Set();
+    let stop;
+    view = { ...store, subscribe(listener) {
+        const notify = (state, previous) => listener(state, previous);
+        listeners.add(notify);
+        if (!stop) stop = store.subscribe((state, previous) => {
+            if (state.connection === previous.connection &&
+                state.connectionClickStartHandle === previous.connectionClickStartHandle &&
+                state.connectionMode === previous.connectionMode) return;
+            listeners.forEach(notify => notify(state, previous));
+        });
+        return () => {
+            if (!listeners.delete(notify) || listeners.size) return;
+            stop?.();
+            stop = undefined;
+        };
+    } };
+    connectionStores.set(store, view);
+    return view;
+}
