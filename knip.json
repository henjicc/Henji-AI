{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["packages/ai-sdk"],
  "includeEntryExports": true,
  "entry": [
    "src/main.tsx",
    "electron/main/index.ts",
    "electron/preload/index.ts",
    "electron/main/*-utility.ts",
    "electron/main/*-worker.ts",
    "electron/main/services/audio/waveform-worker.ts",
    "electron/main/services/fonts/worker.ts",
    "src/**/*{Worker,worker}.ts",
    "src/**/*.test.{ts,tsx}",
    "electron/**/*.test.ts",
    "src/tests/setup.ts",
    "scripts/**/*.{cjs,mjs,js,ts}",
    "*.config.{ts,js,cjs}",
    "src/core/examples/*.ts",
    "src/**/index.{ts,tsx}",
    "src/features/documents/application/documentPromptStoreLedger.ts",
    "src/features/videoEdit/engine/videoEditColorGradeShader.ts",
    "src/features/canvas/extensions/CanvasExtension.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "electron/**/*.ts", "scripts/**/*.{cjs,mjs,js,ts}", "*.config.{ts,js,cjs}", "!scripts/__fixtures__/**"],
  "ignoreDependencies": [
    "henji-author-opentype.js-2.0.0",
    "henji-author-three-0.186.1",
    "henji-author-three-types-0.186.1"
  ],
  "ignoreIssues": {
    "electron.vite.config.ts": ["exports"],
    "vite.config.ts": ["exports"],
    "vitest.config.ts": ["exports"],
    "postcss.config.js": ["exports"],
    "scripts/electron-builder-after-pack.cjs": ["exports"]
  },
  "ignoreUnresolved": [
    "./audio-edit-mask-worker.cjs",
    "./audio-edit-mouth-click-worker.cjs",
    "./audio-edit-effects-worker.cjs",
    "./font-worker.cjs",
    "./image-registration-worker.cjs",
    "./image-color-lut-worker.cjs"
  ],
  "ignoreBinaries": ["attrib", "cargo", "rustup", "dumpbin", "powershell", "pwsh", "ffmpeg", "ffprobe", "reg", "taskkill.exe"]
}
