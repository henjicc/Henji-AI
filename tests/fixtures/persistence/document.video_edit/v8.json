        "profile": {
          "summary": "少而精：留白、精确对齐与粗细对比，单一强调色，落地即静止。",
          "scenarios": [
            "品牌片",
            "产品发布",
            "高端访谈"
          ],
          "concepts": [
            {
              "id": "concept-1",
              "name": "留白",
              "meaning": "画面不满，主体有呼吸空间。",
              "criteria": [
                "同屏只有一个视觉焦点",
                "文字与图形合计不超过画面 35%",
                "元素与画边的距离不小于安全边距"
              ],
              "tendencies": "入场用慢档强减速；错峰 0.08 秒以上；字号拉开层级而不是加装饰。",
              "positive": "大面积底色上一行左对齐标题，下方一行小字说明。",
              "negative": "满屏信息卡、多处强调色同时出现。",
              "strength": "must",
              "exceptions": ""
            },
            {
              "id": "concept-2",
              "name": "克制",
              "meaning": "动作少、幅度小，靠节奏而不是特效取胜。",
              "criteria": [
                "同一时刻运动的元素不超过两个",
                "没有回弹和持续漂浮",
                "位移不超过画高 4%"
              ],
              "tendencies": "位移幅度 3% 画高；强调只用颜色或字重变化。",
              "positive": "标题从下方 3% 处淡入落定后完全静止。",
              "negative": "标题弹跳入场后仍在缓慢浮动。",
