{
  "name": "@henjicc/ai-sdk",
  "version": "0.1.8",
  "description": "痕迹AI 多供应商模型适配 SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henjicc/Henji-AI.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://github.com/henjicc/Henji-AI/tree/main/packages/ai-sdk",
  "bugs": {
    "url": "https://github.com/henjicc/Henji-AI/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./generation": {
      "types": "./dist/generation.d.ts",
      "import": "./dist/generation.js",
      "default": "./dist/generation.js"
    },
    "./generation/core": {
      "types": "./dist/generation/core.d.ts",
      "import": "./dist/generation/core.js",
      "default": "./dist/generation/core.js"
    },
    "./models/*": {
      "types": "./dist/packs/models/*.d.ts",
      "import": "./dist/packs/models/*.js",
      "default": "./dist/packs/models/*.js"
    },
    "./provider-adapters/*": {
      "types": "./dist/packs/provider-adapters/*.d.ts",
      "import": "./dist/packs/provider-adapters/*.js",
      "default": "./dist/packs/provider-adapters/*.js"
    },
    "./provider-packs/*": {
      "types": "./dist/packs/provider-packs/*.d.ts",
      "import": "./dist/packs/provider-packs/*.js",
      "default": "./dist/packs/provider-packs/*.js"
    },
    "./tool-models/*": {
      "types": "./dist/packs/tool-models/*.d.ts",
      "import": "./dist/packs/tool-models/*.js",
      "default": "./dist/packs/tool-models/*.js"
    },
    "./tool-packs/*": {
      "types": "./dist/packs/tool-packs/*.d.ts",
      "import": "./dist/packs/tool-packs/*.js",
      "default": "./dist/packs/tool-packs/*.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js",
      "default": "./dist/catalog/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js",
      "default": "./dist/llm/index.js"
    },
    "./llm/streaming": {
      "types": "./dist/llm/streaming/index.d.ts",
      "import": "./dist/llm/streaming/index.js",
      "default": "./dist/llm/streaming/index.js"
    },
    "./llm/groq": {
      "types": "./dist/llm/groq/index.d.ts",
      "import": "./dist/llm/groq/index.js",
      "default": "./dist/llm/groq/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js",
      "default": "./dist/capabilities/index.js"
    },
    "./capabilities/speech-recognition": {
      "types": "./dist/capabilities/speech-recognition/index.d.ts",
      "import": "./dist/capabilities/speech-recognition/index.js",
      "default": "./dist/capabilities/speech-recognition/index.js"
    },
    "./capabilities/speech-recognition/bailian": {
      "types": "./dist/capabilities/speech-recognition/bailian/index.d.ts",
      "import": "./dist/capabilities/speech-recognition/bailian/index.js",
      "default": "./dist/capabilities/speech-recognition/bailian/index.js"
    },
    "./capabilities/translation": {
      "types": "./dist/capabilities/translation/index.d.ts",
      "import": "./dist/capabilities/translation/index.js",
      "default": "./dist/capabilities/translation/index.js"
    },
    "./capabilities/realtime": {
      "types": "./dist/capabilities/realtime.d.ts",
      "import": "./dist/capabilities/realtime.js",
      "default": "./dist/capabilities/realtime.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js",
      "default": "./dist/discovery/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples/*/README.md",
    "examples/*/index.ts",
    "examples/form-renderer/cli.ts",
    "examples/*/package.json",
    "examples/*/tsconfig.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "vitest run --root ../.. packages/ai-sdk",
    "prepublishOnly": "node scripts/prepublish-check.cjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.62",
    "@ai-sdk/provider-utils": "4.0.40",
    "ai": "6.0.234",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.0.2"
  }
}
