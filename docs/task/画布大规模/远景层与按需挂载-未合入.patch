+import { useEffect, useRef } from 'react';
+import { useStoreApi } from '@xyflow/react';
+import { createLogger } from '@/core/logging';
+import type { CanvasEdge, CanvasNode } from '@/features/canvas/domain/canvasNodes';
+import { canvasEventBus } from '@/features/canvas/application/canvasServices';
+import { useCanvasNodePresence } from '@/features/canvas/presence/useCanvasNodePresence';
+import { createFarLayerScene, type FarLayerEdge, type FarLayerNode } from './farLayerScene';
+import { createFarLayerRenderer, type FarLayerColors, type FarLayerRenderer } from './farLayerRenderer';
+import { createFarLayerTiles, type FarLayerTiles } from './farLayerTiles';
+
+const logger = createLogger('features.canvas.farLayer');
+
+/** 画面排队与加载的推进间隔：缩略图陆续回来、视口连续移动时，这么久统一处理一次 */
+const TILE_REFRESH_INTERVAL_MS = 90;
+/** 节点组件要接住的操作（导入文件等）到来时，正文保持挂载的时长 */
+const NODE_OPERATION_PIN_MS = 15_000;
+
+function readTriplet(style: CSSStyleDeclaration, name: string): [number, number, number] {
+  const parts = style.getPropertyValue(name).trim().split(/[\s,]+/).map(Number);
+  return [(parts[0] ?? 0) / 255, (parts[1] ?? 0) / 255, (parts[2] ?? 0) / 255];
+}
+
+function readTheme(element: HTMLElement): { colors: FarLayerColors; palette: { panel: string; text: string; subtle: string; fontFamily: string } } {
+  const style = getComputedStyle(element);
+  const css = (name: string) => `rgb(${style.getPropertyValue(name).trim()})`;
+  // 圆角是带 var() 与 calc() 的令牌，借一个临时元素让浏览器算出像素值
+  const probe = element.ownerDocument.createElement('div');
+  probe.style.borderRadius = 'var(--node-radius)';
+  element.parentElement?.appendChild(probe);
+  const radius = Number.parseFloat(getComputedStyle(probe).borderTopLeftRadius) || 0;
+  probe.remove();
+  const subtle = readTriplet(style, '--text3-rgb');
+  return {
+    colors: {
+      panel: readTriplet(style, '--panel-rgb'), border: subtle, edge: subtle,
+      accent: readTriplet(style, '--accent-rgb'), group: readTriplet(style, '--hover-rgb'), radius,
+    },
+    palette: { panel: css('--panel-rgb'), text: css('--text1-rgb'), subtle: css('--text3-rgb'), fontFamily: style.fontFamily || 'sans-serif' },
+  };
+}
+
+/**
+ * 画布远景层：铺在节点下面的一块画布，每一帧把所有节点和连线都画出来。
+ * 节点正文（真 DOM）只在近景挂载并盖在它上面；正文没挂上、缩放太小或者正在加载时，看到的就是这一层，
+ * 所以不管怎么快速缩放，节点都一直在。
+ */
+export function CanvasFarLayer(): JSX.Element {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const store = useStoreApi<CanvasNode, CanvasEdge>();
+  const presence = useCanvasNodePresence();
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    let renderer: FarLayerRenderer | null = null;
+    let tiles: FarLayerTiles | null = null;
+    let gl: WebGL2RenderingContext | null = null;
+    const scene = createFarLayerScene();
+    let nodes: FarLayerNode[] = [];
+    let edges: FarLayerEdge[] = [];
+    let theme = readTheme(canvas);
+    let frame: number | null = null;
+    let sceneDirty = true;
+    let tilesDirty = true;
+    let viewMovedAt = 0;
+    let tilesUpdatedAt = 0;
+    let wasFading = false;
+    let previousTransform = store.getState().transform;
+    let disposed = false;
+    const seconds = () => performance.now() / 1000;
+
+    function view() {
+      const [x, y, zoom] = store.getState().transform;
+      return { x, y, zoom, width: canvas!.clientWidth, height: canvas!.clientHeight, dpr: window.devicePixelRatio || 1 };
+    }
+
+    function resize(): void {
+      const dpr = window.devicePixelRatio || 1;
+      const width = Math.max(1, Math.round(canvas!.clientWidth * dpr));
+      const height = Math.max(1, Math.round(canvas!.clientHeight * dpr));
+      if (canvas!.width !== width || canvas!.height !== height) { canvas!.width = width; canvas!.height = height; }
+    }
+
+    function draw(): boolean {
+      if (!renderer || !tiles) return false;
+      return renderer.draw(view(), theme.colors, tiles, seconds());
+    }
+
+    function schedule(): void {
+      if (disposed || frame !== null) return;
+      frame = requestAnimationFrame(runFrame);
+    }
+
+    function runFrame(): void {
+      frame = null;
+      if (disposed || !renderer || !tiles) return;
+      const rebuilt = sceneDirty;
+      if (sceneDirty) {
+        sceneDirty = false;
+        ({ nodes, edges } = scene.build(store.getState(), presence.isActive));
+      }
+      // 画面的排队与加载不必每帧推进：缩略图一张张回来、视口连续移动时，隔一小段时间统一处理一次
+      const stamp = performance.now();
+      const tilesWaiting = tilesDirty || viewMovedAt > tilesUpdatedAt;
+      const tilesDue = tilesWaiting && (tilesUpdatedAt === 0 || stamp - tilesUpdatedAt >= TILE_REFRESH_INTERVAL_MS);
+      if (tilesDue) {
+        tilesDirty = false;
+        tilesUpdatedAt = stamp;
+        const current = view();
+        const more = tiles.update(nodes, {
+          left: -current.x / current.zoom, top: -current.y / current.zoom,
+          right: (current.width - current.x) / current.zoom, bottom: (current.height - current.y) / current.zoom,
+          devicePixelsPerUnit: current.zoom * current.dpr,
+        });
+        if (more) tilesDirty = true;
+      }
+      if (rebuilt || tilesDue) {
+        renderer.setNodes(nodes, tiles);
+        // 近景时两端都挂着正文的连线由 ReactFlow 画，这里只补它画不出的
+        renderer.setEdges(edges, presence.isNear());
+      }
+      const fading = rebuilt || tilesDue || wasFading ? draw() : false;
+      wasFading = fading;
+      if (fading || tilesDirty || viewMovedAt > tilesUpdatedAt) schedule();
+    }
+
+    function start(): void {
+      gl = canvas!.getContext('webgl2', { alpha: true, premultipliedAlpha: true, antialias: false, powerPreference: 'high-performance' });
+      if (!gl) throw new Error('当前环境不支持 WebGL2');
+      renderer = createFarLayerRenderer(gl);
+      tiles = createFarLayerTiles(gl, {
+        nodeCapacity: Math.max(1024, Math.ceil(store.getState().nodeLookup.size * 1.5)),
+        onChange: () => { tilesDirty = true; schedule(); },
+        now: seconds,
+      });
+      tiles.setPalette(theme.palette);
+      sceneDirty = true; tilesDirty = true;
+      resize();
+      schedule();
+    }
+
+    function stop(): void {
+      renderer?.dispose(); tiles?.dispose();
+      renderer = null; tiles = null;
+    }
+
+    /** 远景层画不了时退回全部节点挂真 DOM 的旧行为；放到微任务里，避开 React 提交阶段。 */
+    function fallBack(reason: unknown): void {
+      logger.warn('画布远景层不可用，改为全部节点常驻挂载', { event: 'canvas.far_layer.unavailable', error: reason });
+      queueMicrotask(() => { if (!disposed) presence.setEnabled(false); });
+    }
+
+    try { start(); } catch (error) { stop(); fallBack(error); }
+
+    const onContextLost = (event: Event) => { event.preventDefault(); stop(); fallBack('context lost'); };
+    const onContextRestored = () => {
+      try { start(); queueMicrotask(() => { if (!disposed) presence.setEnabled(true); }); } catch (error) { stop(); fallBack(error); }
+    };
+    canvas.addEventListener('webglcontextlost', onContextLost);
+    canvas.addEventListener('webglcontextrestored', onContextRestored);
+
+    const stopStore = store.subscribe((state) => {
+      if (state.transform !== previousTransform) {
+        previousTransform = state.transform;
+        viewMovedAt = performance.now();
+        // 与节点层的视口变换同一帧落屏：视口变了立刻用现有实例重画，不等下一帧
+        draw();
+        schedule();
+        return;
+      }
+      sceneDirty = true;
+      schedule();
+    });
+    const stopPresence = presence.subscribeState(() => { sceneDirty = true; schedule(); });
+    const flowElement = canvas.closest<HTMLElement>('.react-flow');
+    // 指针换算用的画布位置：只在尺寸变化时重读，指针移动途中不读布局
+    let flowBounds = flowElement?.getBoundingClientRect();
+    const onResize = () => { flowBounds = flowElement?.getBoundingClientRect(); resize(); draw(); };
+    const resizeObserver = new ResizeObserver(onResize);
+    resizeObserver.observe(canvas);
+    // 窗口挪到另一块屏幕时设备像素比会变而元素尺寸不变
+    window.addEventListener('resize', onResize);
+    const themeObserver = new MutationObserver(() => {
+      theme = readTheme(canvas);
+      tiles?.setPalette(theme.palette);
+      sceneDirty = true;
+      schedule();
+    });
+    themeObserver.observe(canvas.ownerDocument.documentElement, { attributes: true, attributeFilter: ['style', 'class', 'data-theme'] });
+
+    // 指针停在哪个没挂正文的节点上，就让它出一个空外框接住点选、拖动与右键
+    const onPointerMove = (event: PointerEvent) => {
+      // 按着键移动是拖动或框选途中，不换目标
+      if (event.buttons !== 0 || !flowBounds) return;
+      if (event.target instanceof Element && event.target.closest('.react-flow__node')) return;
+      const state = store.getState();
+      const bounds = flowBounds;
+      const [x, y, zoom] = state.transform;
+      const pointX = (event.clientX - bounds.left - x) / zoom;
+      const pointY = (event.clientY - bounds.top - y) / zoom;
+      let hit: string | null = null;
+      // 后面的节点画在上面，取最后一个命中的
+      for (const entry of nodes) {
+        if (pointX >= entry.x && pointX <= entry.x + entry.width && pointY >= entry.y && pointY <= entry.y + entry.height && !presence.isActive(entry.id)) hit = entry.id;
+      }
+      presence.setShell(hit);
+    };
+    flowElement?.addEventListener('pointermove', onPointerMove, { passive: true });
+
+    // 这些操作由节点组件自己接住，正文没挂着就会落空：先把它挂上
+    const pin = ({ nodeId }: { nodeId: string }) => presence.pin(nodeId, NODE_OPERATION_PIN_MS);
+    const stopEvents = [
+      canvasEventBus.subscribe('canvas/import-media', pin),
+      canvasEventBus.subscribe('upload-node/reupload', pin),
+      canvasEventBus.subscribe('upload-node/paste-image', pin),
+    ];
+
+    return () => {
+      disposed = true;
+      if (frame !== null) cancelAnimationFrame(frame);
+      stopStore(); stopPresence(); resizeObserver.disconnect(); themeObserver.disconnect();
+      window.removeEventListener('resize', onResize);
+      stopEvents.forEach(stopEvent => stopEvent());
+      flowElement?.removeEventListener('pointermove', onPointerMove);
+      canvas.removeEventListener('webglcontextlost', onContextLost);
+      canvas.removeEventListener('webglcontextrestored', onContextRestored);
+      stop();
+    };
+  }, [presence, store]);
+
+  return <canvas ref={canvasRef} aria-hidden className="pointer-events-none absolute inset-0 h-full w-full" />;
+}
diff --git a/src/features/canvas/presence/canvasNodePresence.test.ts b/src/features/canvas/presence/canvasNodePresence.test.ts
new file mode 100644
index 000000000..a5abb03d1
--- /dev/null
+++ b/src/features/canvas/presence/canvasNodePresence.test.ts
@@ -0,0 +1,97 @@
+import { describe, expect, it } from 'vitest';
+import { createCanvasNodePresence, MAX_ACTIVE_CANVAS_NODES, type CanvasNodePresenceSource } from './canvasNodePresence';
+
+interface FixtureNode { id: string; x: number; y: number; measured?: boolean }
+
+function fixture(nodes: FixtureNode[], zoom: number) {
+  const listeners = new Set<() => void>();
+  const rendered: { henjiRenderedNodeIds?: string[] | null } = {};
+  const state = {
+    transform: [0, 0, zoom] as [number, number, number],
+    width: 1000,
+    height: 800,
+    domNode: null,
+    nodes: [] as unknown[],
+    edges: [] as Array<{ id: string; source: string; target: string }>,
+    nodeLookup: new Map(nodes.map(node => [node.id, {
+      id: node.id, type: 'uploadNode', hidden: false, dragging: false,
+      measured: node.measured === false ? {} : { width: 100, height: 100 },
+      internals: { positionAbsolute: { x: node.x, y: node.y } },
+    }])),
+  };
+  const source = {
+    getState: () => state,
+    subscribe: (listener: () => void) => { listeners.add(listener); return () => listeners.delete(listener); },
+    setState: (ids: object) => { Object.assign(rendered, ids); },
+    seed: (ids: object) => { Object.assign(rendered, ids); },
+  } as unknown as CanvasNodePresenceSource;
+  let clock = 0;
+  const frames: Array<() => void> = [];
+  const presence = createCanvasNodePresence(source, {
+    getZoomThreshold: () => 0.4,
+    now: () => clock,
+    requestFrame: (callback) => { frames.push(callback); return frames.length; },
+    cancelFrame: () => undefined,
+  });
+  return {
+    presence,
+    rendered,
+    setZoom(next: number) { state.transform = [0, 0, next]; listeners.forEach(listener => listener()); },
+    /** 推进若干帧；每帧时钟走 16ms，时间预算因此每帧都用得完一批。 */
+    run(count = 1) { for (let i = 0; i < count && frames.length; i += 1) { clock += 16; frames.shift()?.(); } },
+    advance(ms: number) { clock += ms; },
+    pendingFrames: () => frames.length,
+  };
+}
+
+describe('节点正文挂载调度', () => {
+  it('近景只挂视口附近的节点，远景全部交给远景层，没量过尺寸的节点不论缩放都要挂一次', () => {
+    const { presence, setZoom, run, advance } = fixture([
+      { id: 'inside', x: 100, y: 100 },
+      { id: 'faraway', x: 50_000, y: 50_000 },
+      { id: 'fresh', x: 90_000, y: 0, measured: false },
+    ], 1);
+    presence.arm();
+    run(8);
+    expect(presence.modeOf('inside')).toBe('body');
+    expect(presence.modeOf('faraway')).toBe('off');
+    expect(presence.modeOf('fresh')).toBe('body');
+
+    setZoom(0.1);
+    run(1);
+    // 视口刚动过：正文先留着（节点层同时在淡出），停稳后才卸
+    expect(presence.modeOf('inside')).toBe('body');
+    advance(200);
+    run(4);
+    expect(presence.modeOf('inside')).toBe('off');
+    expect(presence.modeOf('fresh')).toBe('body');
+  });
+
+  it('同时挂载的正文有上限，离视口中心近的优先', () => {
+    const nodes = Array.from({ length: MAX_ACTIVE_CANVAS_NODES + 200 }, (_, index) => ({ id: `n${index}`, x: 500 + index, y: 400 }));
+    const { presence, run } = fixture(nodes, 1);
+    presence.arm();
+    run(2000);
+    expect(presence.activeCount()).toBeLessThanOrEqual(MAX_ACTIVE_CANVAS_NODES);
+    expect(presence.modeOf('n0')).toBe('body');
+    expect(presence.modeOf(`n${nodes.length - 1}`)).toBe('off');
+  });
+
+  it('指针所在的节点成为壳；被点名的节点立刻挂上正文；调度停用后一律按正文', () => {
+    const { presence, rendered, run } = fixture([{ id: 'a', x: 0, y: 0 }, { id: 'b', x: 300, y: 0 }], 0.1);
+    presence.arm();
+    run(2);
+    expect(presence.modeOf('a')).toBe('off');
+    expect(rendered.henjiRenderedNodeIds).toEqual([]);
+    presence.setShell('a');
+    expect(presence.modeOf('a')).toBe('shell');
+    expect(rendered.henjiRenderedNodeIds).toEqual(['a']);
+    presence.setShell('b');
+    expect(presence.modeOf('a')).toBe('off');
+    presence.pin('a', 1000);
+    expect(presence.modeOf('a')).toBe('body');
+    presence.setEnabled(false);
+    expect(presence.modeOf('b')).toBe('body');
+    expect(rendered.henjiRenderedNodeIds).toBeNull();
+  });
+});
diff --git a/src/features/canvas/presence/canvasNodePresence.ts b/src/features/canvas/presence/canvasNodePresence.ts
new file mode 100644
index 000000000..580645702
--- /dev/null
+++ b/src/features/canvas/presence/canvasNodePresence.ts
@@ -0,0 +1,337 @@
+import type { ReactFlowState } from '@xyflow/react';
+
+/**
+ * 画布节点的按需挂载调度。
+ *
+ * 大画布上绝大多数节点不挂任何 DOM，画面由远景层（farLayer）常驻绘制；这里决定哪些节点交给
+ * ReactFlow 渲染，并把名单写进它的 store（`henjiRenderedNodeIds` / `henjiRenderedEdgeIds`，
+ * 由 patches/ 里的 ReactFlow 补丁读取）。被渲染的节点有两种形态：
+ * - 正文：视口附近且缩放够大的节点，按每帧时间预算分批挂上、分批卸下；
+ * - 壳：只有一个同尺寸的空块。指针停在哪个没挂正文的节点上，哪个节点就是壳，于是点选、拖动、
+ *   右键仍由 ReactFlow 原生处理，而同一时刻最多只多出一个空外框。
+ * 连线只有两端都挂着正文时才交给 ReactFlow，其余由远景层画。
+ *
+ * 没量过尺寸的节点（刚新建）不受缩放限制，排队挂载一次以取得真实尺寸与端口位置。
+ */
+
+type PresenceState = Pick<ReactFlowState, 'nodes' | 'nodeLookup' | 'edges' | 'transform' | 'width' | 'height' | 'domNode'>;
+/** 交给 ReactFlow 的渲染名单；null 表示不干预（全部渲染）。 */
+export interface CanvasRenderedIds {
+  henjiRenderedNodeIds: string[] | null;
+  henjiRenderedEdgeIds: string[] | null;
+}
+export interface CanvasNodePresenceSource {
+  getState(): PresenceState;
+  subscribe(listener: () => void): () => void;
+  /** 写入渲染名单并通知 ReactFlow 重新渲染节点层。 */
+  setState(partial: CanvasRenderedIds): void;
+  /** 写入渲染名单但不发通知：只在画布外壳首次渲染、节点层还没挂载时用。 */
+  seed(partial: CanvasRenderedIds): void;
+}
+
+export interface CanvasNodePresenceOptions {
+  /** 正文开始挂载的缩放；低于它全部交给远景层。 */
+  getZoomThreshold(): number;
+  /** 同步提交一批变更并返回；默认直接执行（测试用），画布里传 flushSync，这样才能量出挂载花了多久。 */
+  commit?(apply: () => void): void;
+  now?(): number;
+  requestFrame?(callback: () => void): number;
+  cancelFrame?(handle: number): void;
+}
+
+/** 同时挂载正文的节点上限：超过的部分留给远景层，保证 DOM 规模有界。 */
+export const MAX_ACTIVE_CANVAS_NODES = 360;
+/** 视口向外扩多少（占视口边长的比例）开始预挂载，离开多远才卸载。 */
+const ACTIVATE_MARGIN = 0.3;
+const RELEASE_MARGIN = 0.7;
+/** 缩放回落到阈值的这个比例以下才整体退出近景，避免在阈值附近来回挂卸。 */
+const FAR_HYSTERESIS = 0.85;
+/**
+ * 视口在动（平移或缩放）时不挂也不卸正文：挂一个节点连同布局、绘制要十几毫秒，放在运动途中就是掉帧，
+ * 而这时画面本来就由远景层画着。停稳这么久之后再按每帧时间预算补挂。
+ */
+const SETTLE_MS = 110;
+/** 帧很慢时两次视口变化之间本来就可能隔过上面的时长，所以还要连续这么多帧没动才算停稳。 */
+const SETTLE_FRAMES = 3;
+const MOUNT_BUDGET_MS = 8;
+/** 退出近景后正文再留这么久才开始卸载：节点层先整体淡出，露出下面的远景画面。 */
+const FAR_RELEASE_DELAY_MS = 140;
+/** 排队先后（数值越小越先挂）：视口附近的节点在 0 到 2 之间，其后是视口内连线的另一端，最后是等着量尺寸的节点。 */
+const NEIGHBOR_PRIORITY = 3;
+const UNMEASURED_PRIORITY = 4;
+
+export type CanvasNodeBodyMode = 'off' | 'shell' | 'body';
+
+function hasSize(width: number | undefined, height: number | undefined): boolean {
+  return typeof width === 'number' && width > 0 && typeof height === 'number' && height > 0;
+}
+
+export function createCanvasNodePresence(source: CanvasNodePresenceSource, options: CanvasNodePresenceOptions) {
+  const commit = options.commit ?? (apply => apply());
+  const now = options.now ?? (() => performance.now());
+  const requestFrame = options.requestFrame ?? (callback => requestAnimationFrame(callback));
+  const cancelFrame = options.cancelFrame ?? (handle => cancelAnimationFrame(handle));
+
+  /** 按节点订阅形态变化（壳与正文之间切换时，外框不变、里面的内容要换）。 */
+  const listeners = new Map<string, Set<() => void>>();
+  const stateListeners = new Set<() => void>();
+  const active = new Set<string>();
+  /** 被点名必须挂着的节点（如正在接收导入文件）及其到期时间。 */
+  const pinned = new Map<string, number>();
+  let shellId: string | null = null;
+  let enabled = false;
+  let near = false;
+  let frame: number | null = null;
+  let stopSource: (() => void) | undefined;
+  let previousTransform: readonly number[] | undefined;
+  let publishedEdges: PresenceState['edges'] | undefined;
+  let plannedNodes: PresenceState['nodes'] | undefined;
+  let lastMoveAt = Number.NEGATIVE_INFINITY;
+  let framesSinceMove = SETTLE_FRAMES;
+  let farSince = Number.NEGATIVE_INFINITY;
+
+  function renderedIds(state: PresenceState): CanvasRenderedIds {
+    // 沿用节点原有的先后顺序：同层级的节点谁压着谁不因挂载先后而变
+    const nodeIds: string[] = [];
+    for (const id of state.nodeLookup.keys()) if (active.has(id) || id === shellId) nodeIds.push(id);
+    const edgeIds: string[] = [];
+    for (const edge of state.edges) if (active.has(edge.source) && active.has(edge.target)) edgeIds.push(edge.id);
+    return { henjiRenderedNodeIds: nodeIds, henjiRenderedEdgeIds: edgeIds };
+  }
+
+  /** 把当前名单交给 ReactFlow，并通知形态变了的节点。 */
+  function publish(changed: Iterable<string>): void {
+    commit(() => {
+      const state = source.getState();
+      publishedEdges = state.edges;
+      source.setState(renderedIds(state));
+      for (const id of changed) listeners.get(id)?.forEach(listener => listener());
+    });
+  }
+
+  function notifyState(): void {
+    stateListeners.forEach(listener => listener());
+  }
+
+  function schedule(): void {
+    if (!enabled || frame !== null) return;
+    frame = requestFrame(() => { frame = null; reconcile(); });
+  }
+
+  /** 应当挂载的节点，按离视口中心由近到远排列；以及允许继续保留的范围判断。 */
+  function plan(state: PresenceState, timestamp: number) {
+    const [x, y, zoom] = state.transform;
+    const threshold = options.getZoomThreshold();
+    const wasNear = near;
+    near = near ? zoom >= threshold * FAR_HYSTERESIS : zoom >= threshold;
+    if (wasNear && !near) farSince = timestamp;
+    const centerX = (state.width / 2 - x) / zoom;
+    const centerY = (state.height / 2 - y) / zoom;
+    const halfWidth = state.width / zoom / 2;
+    const halfHeight = state.height / zoom / 2;
+    const focusedId = state.domNode?.ownerDocument.activeElement?.closest<HTMLElement>('.react-flow__node')?.dataset.id;
+
+    const wanted: Array<{ id: string; distance: number }> = [];
+    const forced: string[] = [];
+    const retainable = new Set<string>();
+    const inView = new Set<string>();
+    const wantedIds = new Set<string>();
+    for (const node of state.nodeLookup.values()) {
+      if (node.hidden) continue;
+      const width = node.measured.width;
+      const height = node.measured.height;
+      const pinnedUntil = pinned.get(node.id);
+      if (pinnedUntil !== undefined && pinnedUntil <= timestamp) pinned.delete(node.id);
+      // 正在输入、正在拖动的正文不能中途卸掉
+      if (pinned.has(node.id) || node.id === focusedId || (node.dragging && active.has(node.id))) {
+        forced.push(node.id);
+        continue;
+      }
+      const left = node.internals.positionAbsolute.x;
+      const top = node.internals.positionAbsolute.y;
+      const dx = Math.max(0, Math.abs(left + (width ?? 0) / 2 - centerX) - (width ?? 0) / 2);
+      const dy = Math.max(0, Math.abs(top + (height ?? 0) / 2 - centerY) - (height ?? 0) / 2);
+      // 归一到“几个视口半径”，横纵取大者：1 以内就是与视口相交
+      const distance = Math.max(dx / halfWidth, dy / halfHeight);
+      if (!hasSize(width, height)) {
+        // 还没有真实尺寸：不论缩放都要挂一次。排在视口内节点之后，离得近的先量。
+        wanted.push({ id: node.id, distance: distance + UNMEASURED_PRIORITY });
+        wantedIds.add(node.id);
+        continue;
+      }
+      if (!near) continue;
+      if (distance <= 1) inView.add(node.id);
+      if (distance <= 1 + RELEASE_MARGIN) retainable.add(node.id);
+      if (distance <= 1 + ACTIVATE_MARGIN) { wanted.push({ id: node.id, distance }); wantedIds.add(node.id); }
+    }
+    // 视口里节点的连线另一端也挂上（排在视口附近的节点之后）：两端都有真实端口，这条线才能由 ReactFlow 画出来、
+    // 才点得中、删得掉；另一端在屏幕外，挂上后由布局暂停机制收起，不参与绘制。
+    if (inView.size) {
+      for (const edge of state.edges) {
+        const other = inView.has(edge.source) ? edge.target : inView.has(edge.target) ? edge.source : null;
+        if (other === null || wantedIds.has(other) || !state.nodeLookup.has(other)) continue;
+        wantedIds.add(other);
+        retainable.add(other);
+        wanted.push({ id: other, distance: NEIGHBOR_PRIORITY });
+      }
+    }
+    wanted.sort((a, b) => a.distance - b.distance);
+    const limit = Math.max(0, MAX_ACTIVE_CANVAS_NODES - forced.length);
+    const desired = [...forced, ...wanted.slice(0, limit).map(entry => entry.id)];
+    for (const id of forced) retainable.add(id);
+    return { desired, retainable };
+  }
+
+  function reconcile(): void {
+    if (!enabled) return;
+    const started = now();
+    const state = source.getState();
+    if (!state.width || !state.height) { schedule(); return; }
+    // 远景里什么都没挂、节点也没变：视口怎么动都无事可做，不必每帧把全部节点过一遍
+    if (!near && active.size === 0 && pinned.size === 0 && state.nodes === plannedNodes
+      && state.transform[2] < options.getZoomThreshold()) return;
+    plannedNodes = state.nodes;
+    const wasNear = near;
+    const { desired, retainable } = plan(state, started);
+    const fadingOut = !near && started - farSince < FAR_RELEASE_DELAY_MS;
+    const desiredSet = new Set(desired);
+    framesSinceMove += 1;
+    const moving = started - lastMoveAt < SETTLE_MS || framesSinceMove < SETTLE_FRAMES;
+    const budget = MOUNT_BUDGET_MS;
+
+    // 先卸载：正文离开后远景层的画面本来就在下面，卸载比挂载便宜得多
+    const release: string[] = [];
+    let overflow = active.size - MAX_ACTIVE_CANVAS_NODES;
+    for (const id of active) {
+      if (desiredSet.has(id)) continue;
+      // 仍在保留范围内的不急着卸，除非已经超出上限
+      if ((moving || fadingOut || retainable.has(id)) && overflow <= 0 && state.nodeLookup.has(id)) continue;
+      release.push(id);
+      overflow -= 1;
+    }
+    let pending = false;
+    let changed = false;
+    for (let index = 0; index < release.length;) {
+      const batch = release.slice(index, index + 24);
+      batch.forEach(id => active.delete(id));
+      publish(batch);
+      changed = true;
+      index += batch.length;
+      if (index < release.length && now() - started >= budget) { pending = true; break; }
+    }
+
+    const admit = desired.filter(id => !active.has(id));
+    if (moving && (admit.length || active.size)) pending = true;
+    for (let index = 0; index < admit.length && !moving;) {
+      // 每帧至少挂一个，其后按时间预算决定
+      if (index > 0 && now() - started >= budget) { pending = true; break; }
+      const batch = admit.slice(index, index + 1);
+      batch.forEach(id => active.add(id));
+      if (shellId !== null && active.has(shellId)) shellId = null;
+      publish(batch);
+      changed = true;
+      index += batch.length;
+    }
+    // 新连上的线两端若都挂着正文，要补进名单
+    if (!changed && state.edges !== publishedEdges) publish([]);
+    if (changed || wasNear !== near) notifyState();
+    if (pending || pinned.size || fadingOut) schedule();
+  }
+
+  function start(): void {
+    if (stopSource) return;
+    stopSource = source.subscribe(() => {
+      const transform = source.getState().transform;
+      if (transform !== previousTransform) {
+        previousTransform = transform;
+        lastMoveAt = now();
+        framesSinceMove = 0;
+      }
+      schedule();
+    });
+    schedule();
+  }
+
+  function stop(): void {
+    stopSource?.(); stopSource = undefined;
+    if (frame !== null) cancelFrame(frame);
+    frame = null;
+  }
+
+  function reset(): void {
+    enabled = false; near = false; shellId = null; publishedEdges = undefined; plannedNodes = undefined;
+    active.clear(); pinned.clear();
+  }
+
+  return {
+    /** 调度是否生效；未生效时全部节点照常渲染（远景层不可用时的退路）。 */
+    isEnabled: () => enabled,
+    setEnabled(next: boolean): void {
+      if (enabled === next) return;
+      if (next) {
+        enabled = true;
+        start();
+        publish(listeners.keys());
+      } else {
+        stop(); reset();
+        commit(() => {
+          source.setState({ henjiRenderedNodeIds: null, henjiRenderedEdgeIds: null });
+          for (const set of listeners.values()) set.forEach(listener => listener());
+        });
+      }
+      notifyState();
+    },
+    /** 在节点层首次渲染之前开启调度（不发通知）：画布外壳渲染时调用，于是一开始就不挂任何节点。 */
+    arm(): void {
+      if (enabled) return;
+      enabled = true;
+      source.seed({ henjiRenderedNodeIds: [], henjiRenderedEdgeIds: [] });
+      start();
+    },
+    /** 画布外壳卸载时停掉调度并交还渲染名单。 */
+    disarm(): void {
+      stop(); reset();
+      source.seed({ henjiRenderedNodeIds: null, henjiRenderedEdgeIds: null });
+    },
+    isActive: (id: string) => !enabled || active.has(id),
+    modeOf: (id: string): CanvasNodeBodyMode => (!enabled || active.has(id) ? 'body' : id === shellId ? 'shell' : 'off'),
+    /** 指针所在的节点设为壳（null 表示指针不在任何未挂正文的节点上）。 */
+    setShell(id: string | null): void {
+      if (!enabled || id === shellId || (id !== null && active.has(id))) return;
+      const previous = shellId;
+      shellId = id;
+      publish([previous, id].filter((value): value is string => value !== null));
+    },
+    isNear: () => near,
+    activeCount: () => active.size,
+    subscribe(id: string, listener: () => void): () => void {
+      let set = listeners.get(id);
+      if (!set) { set = new Set(); listeners.set(id, set); }
+      set.add(listener);
+      return () => {
+        const current = listeners.get(id);
+        if (!current?.delete(listener)) return;
+        if (current.size === 0) listeners.delete(id);
+      };
+    },
+    /** 挂载集合或近景状态变化时通知（远景层据此重画）。 */
+    subscribeState(listener: () => void): () => void {
+      stateListeners.add(listener);
+      return () => { stateListeners.delete(listener); };
+    },
+    /** 立刻挂上某个节点的正文并保持一段时间：给必须由节点组件接住的操作（导入文件、重新上传）用。 */
+    pin(id: string, durationMs: number): void {
+      if (!enabled) return;
+      pinned.set(id, now() + durationMs);
+      if (!active.has(id)) {
+        active.add(id);
+        if (shellId === id) shellId = null;
+        publish([id]);
+        notifyState();
+      }
+      schedule();
+    },
+  };
+}
+
+export type CanvasNodePresence = ReturnType<typeof createCanvasNodePresence>;
