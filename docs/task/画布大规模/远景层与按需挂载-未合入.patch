@@ -0,0 +1,121 @@
+import { Position, type InternalNode, type ReactFlowState } from '@xyflow/react';
+import type { CanvasEdge, CanvasNode } from '@/features/canvas/domain/canvasNodes';
+import { CANVAS_NODE_TYPES } from '@/features/canvas/domain/canvasNodeConstants';
+
+/**
+ * 远景层要画的内容：每个节点一个矩形、每条连线一段三次贝塞尔。
+ * 只读 ReactFlow 已有的位置与量得尺寸，不另存一份几何；端口位置优先用量得的值，
+ * 节点正文没挂载时退回上次记下的相对位置，再没有就取左右两侧中点。
+ */
+
+export interface FarLayerNode {
+  id: string;
+  node: InternalNode<CanvasNode>;
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  selected: boolean;
+  group: boolean;
+}
+
+export interface FarLayerEdge {
+  /** 起点、两个控制点、终点（画布坐标） */
+  points: [number, number, number, number, number, number, number, number];
+  selected: boolean;
+  /** 两端都挂着正文且端口已量得：近景时这条线由 ReactFlow 自己画 */
+  domDrawable: boolean;
+}
+
+interface HandleAnchor { dx: number; dy: number; position: Position }
+
+type SceneState = Pick<ReactFlowState, 'nodeLookup'> & { edges: readonly CanvasEdge[] };
+
+function controlOffset(distance: number): number {
+  // 与 ReactFlow getBezierPath 默认曲率 0.25 相同
+  return distance >= 0 ? 0.5 * distance : 0.25 * 25 * Math.sqrt(-distance);
+}
+
+function controlPoint(position: Position, x1: number, y1: number, x2: number, y2: number): [number, number] {
+  switch (position) {
+    case Position.Left: return [x1 - controlOffset(x1 - x2), y1];
+    case Position.Right: return [x1 + controlOffset(x2 - x1), y1];
+    case Position.Top: return [x1, y1 - controlOffset(y1 - y2)];
+    default: return [x1, y1 + controlOffset(y2 - y1)];
+  }
+}
+
+export function createFarLayerScene() {
+  /** 节点 → 端口键 → 相对节点左上角的连线锚点；正文卸载后仍用它，连线端点不跳。 */
+  const anchors = new Map<string, Map<string, HandleAnchor>>();
+
+  function measuredAnchor(node: InternalNode<CanvasNode>, type: 'source' | 'target', handleId: string | null | undefined): HandleAnchor | null {
+    const bounds = node.internals.handleBounds?.[type];
+    if (!bounds?.length) return null;
+    const handle = handleId ? bounds.find(candidate => candidate.id === handleId) : bounds[0];
+    if (!handle) return null;
+    const position = handle.position ?? (type === 'source' ? Position.Right : Position.Left);
+    const dx = position === Position.Right ? handle.x + handle.width : position === Position.Left ? handle.x : handle.x + handle.width / 2;
+    const dy = position === Position.Bottom ? handle.y + handle.height : position === Position.Top ? handle.y : handle.y + handle.height / 2;
+    return { dx, dy, position };
+  }
+
+  function resolveAnchor(entry: FarLayerNode, type: 'source' | 'target', handleId: string | null | undefined): { anchor: HandleAnchor; measured: boolean } {
+    const key = `${type}:${handleId ?? ''}`;
+    const measured = measuredAnchor(entry.node, type, handleId);
+    if (measured) {
+      let known = anchors.get(entry.id);
+      if (!known) { known = new Map(); anchors.set(entry.id, known); }
+      known.set(key, measured);
+      return { anchor: measured, measured: true };
+    }
+    const remembered = anchors.get(entry.id)?.get(key);
+    if (remembered) return { anchor: remembered, measured: false };
+    return {
+      anchor: type === 'source'
+        ? { dx: entry.width, dy: entry.height / 2, position: Position.Right }
+        : { dx: 0, dy: entry.height / 2, position: Position.Left },
+      measured: false,
+    };
+  }
+
+  function build(state: SceneState, isBodyMounted: (id: string) => boolean): { nodes: FarLayerNode[]; edges: FarLayerEdge[] } {
+    const nodes: FarLayerNode[] = [];
+    const byId = new Map<string, FarLayerNode>();
+    for (const node of state.nodeLookup.values() as IterableIterator<InternalNode<CanvasNode>>) {
+      if (node.hidden) continue;
+      const width = node.measured.width;
+      const height = node.measured.height;
+      // 没量过尺寸的节点由正文挂载调度先挂一次，量到之后才进远景
+      if (!width || !height) continue;
+      const entry: FarLayerNode = {
+        id: node.id, node, width, height,
+        x: node.internals.positionAbsolute.x,
+        y: node.internals.positionAbsolute.y,
+        selected: Boolean(node.selected),
+        group: node.type === CANVAS_NODE_TYPES.group,
+      };
+      nodes.push(entry);
+      byId.set(node.id, entry);
+    }
+    for (const id of anchors.keys()) if (!state.nodeLookup.has(id)) anchors.delete(id);
+
+    const edges: FarLayerEdge[] = [];
+    for (const edge of state.edges) {
+      if (edge.hidden) continue;
+      const source = byId.get(edge.source);
+      const target = byId.get(edge.target);
+      if (!source || !target) continue;
+      const from = resolveAnchor(source, 'source', edge.sourceHandle);
+      const to = resolveAnchor(target, 'target', edge.targetHandle);
+      const x1 = source.x + from.anchor.dx, y1 = source.y + from.anchor.dy;
+      const x2 = target.x + to.anchor.dx, y2 = target.y + to.anchor.dy;
+      const [c1x, c1y] = controlPoint(from.anchor.position, x1, y1, x2, y2);
+      const [c2x, c2y] = controlPoint(to.anchor.position, x2, y2, x1, y1);
+      edges.push({ points: [x1, y1, c1x, c1y, c2x, c2y, x2, y2], selected: Boolean(edge.selected), domDrawable: from.measured && to.measured && isBodyMounted(edge.source) && isBodyMounted(edge.target) });
+    }
+    return { nodes, edges };
+  }
+
+  return { build };
+}
