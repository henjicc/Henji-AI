{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-hooks/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": [
    "react-refresh",
    "@typescript-eslint"
  ],
  "rules": {
    "no-console": "error",
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "react-refresh/only-export-components": "warn",
    "no-unused-vars": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})/]",
        "message": "禁止直接写十六进制颜色，请使用 @/core/theme/colorTokens 或语义化 Tailwind 类。"
      },
      {
        "selector": "TemplateElement[value.raw=/#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})/]",
        "message": "禁止在模板字符串中直接写十六进制颜色，请使用 @/core/theme/colorTokens 或语义化 Tailwind 类。"
      },
      {
        "selector": "Literal[value=/\\[#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})\\]/]",
        "message": "禁止使用 Tailwind 任意十六进制颜色类（如 bg-[#xxxxxx]），请改为语义化颜色类。"
      },
      {
        "selector": "Literal[value=/text-\\[(?:9|10|11)px\\]/]",
        "message": "禁止内联 9/10/11px 字号，请使用已登记的 text-4xs / text-3xs / text-2xs。"
      },
      {
        "selector": "TemplateElement[value.raw=/text-\\[(?:9|10|11)px\\]/]",
        "message": "禁止内联 9/10/11px 字号，请使用已登记的 text-4xs / text-3xs / text-2xs。"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/core/logging/logger.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/core/theme/colorTokens.ts"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": [
        "src/contexts/NotificationContext.tsx",
        "src/features/canvas/nodes/storyboardGen/shared.tsx",
        "src/features/canvas/nodes/storyboardSplit/shared.tsx",
        "src/features/canvas/ui/NodeHeader.tsx"
      ],
      "rules": {
        "react-refresh/only-export-components": "off"
      }
    }
  ]
}
