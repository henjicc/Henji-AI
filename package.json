{
  "name": "henji-ai",
  "private": true,
  "version": "0.1.1",
  "description": "一个聚合多家AI供应商，一站式生成图片、视频和音频的客户端",
  "author": "Henji AI",
  "main": "out/main/index.cjs",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run gen:progress-seeds && npm run gen:model-manifest && vite",
    "gen:progress-seeds": "node scripts/generate-progress-seeds.cjs",
    "gen:model-manifest": "node scripts/generate-model-manifest.cjs",
    "check:colors": "node scripts/check-color-tokens.cjs",
    "check:model-i18n": "node scripts/check-model-i18n.cjs",
    "build": "npm run gen:progress-seeds && npm run gen:model-manifest && npm run check:colors && npm run check:model-i18n && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:colors": "npm run check:colors",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "electron:dev": "npm run gen:progress-seeds && npm run gen:model-manifest && node scripts/electron-vite-dev.cjs",
    "electron:build": "npm run gen:progress-seeds && npm run gen:model-manifest && npm run check:colors && npm run check:model-i18n && tsc -p tsconfig.electron.json && electron-vite build",
    "electron:pack": "npm run electron:build && electron-builder --dir",
    "electron:dist": "npm run electron:build && electron-builder",
    "electron:publish": "npm run electron:build && electron-builder --publish always",
    "electron:smoke": "node scripts/electron-phase4-smoke.cjs",
    "electron:canvas-stress": "node scripts/electron-phase4-canvas-stress.cjs",
    "electron:dpi-check": "node scripts/electron-phase4-dpi-check.cjs",
    "electron:updater-e2e": "node scripts/electron-phase4-updater-e2e.cjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.7.2",
    "@types/react-window": "^1.8.8",
    "@xyflow/react": "^12.10.1",
    "ali-oss": "^6.23.0",
    "archiver": "^8.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.5.0",
    "electron-updater": "^6.8.9",
    "i18next": "^23.7.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "konva": "^10.2.0",
    "lucide-react": "^0.562.0",
    "pica": "^9.0.1",
    "pinyin-match": "^1.2.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-image-crop": "^11.0.10",
    "react-konva": "^18.2.14",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.15.0",
    "react-window": "^2.2.3",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.2",
    "uuid": "^13.0.0",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pica": "^9.0.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "playwright": "^1.61.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
