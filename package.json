{
  "name": "henji-ai",
  "private": true,
  "version": "2.0.0-beta.1",
  "description": "一个聚合多家AI供应商，一站式生成图片、视频和音频的客户端",
  "author": "Henji AI",
  "main": "out/main/index.cjs",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:persistence-compat": "node scripts/check-persistence-compat.cjs",
    "persistence:baseline": "node scripts/check-persistence-compat.cjs --write",
    "postinstall": "patch-package --error-on-fail && npm run prepare:media-binaries && npm run build:sdk",
    "prepare:media-binaries": "node scripts/ensure-media-binary-permissions.cjs",
    "dev": "npm run gen:progress-seeds && npm run gen:licenses && vite",
    "gen:progress-seeds": "node scripts/generate-progress-seeds.cjs",
    "gen:catalog": "node scripts/generate-catalog-index.cjs",
    "gen:licenses": "node scripts/generate-third-party-licenses.cjs",
    "gen:shader-components": "node scripts/generate-shader-components.cjs",
    "check:shader-components": "node scripts/generate-shader-components.cjs --check",
    "package:source": "node scripts/build-source-package.cjs",
    "build:sdk": "node scripts/build-sdk-if-needed.cjs",
    "build:sdk:force": "node scripts/build-sdk-if-needed.cjs --force",
    "build:audio-worker": "node scripts/build-audio-worker.cjs",
    "build:video-decoder": "node scripts/video-decoder-ffmpeg.cjs build",
    "check:colors": "node scripts/check-color-tokens.cjs",
    "check:surface": "node scripts/check-surface-tokens.cjs",
    "check:surface:strict": "node scripts/check-surface-tokens.cjs --strict",
    "check:ui-residue": "node scripts/ui-residue-scan.cjs --strict --no-report",
    "check:model-i18n": "node scripts/check-model-i18n.cjs",
    "check:skill-sync": "node scripts/check-skill-sync.cjs",
    "check:model-updates": "node scripts/check-provider-model-updates.cjs",
    "check:model-updates:strict": "node scripts/check-provider-model-updates.cjs --strict",
    "check:main-imports": "node scripts/check-main-imports.cjs",
    "check:dependency-graph": "node scripts/check-dependency-graph.cjs",
    "dependency-graph:baseline": "node scripts/check-dependency-graph.cjs --write",
    "check:ipc-contract": "node scripts/check-ipc-contract.cjs",
    "check:dead-code": "node scripts/check-dead-code.cjs",
    "dead-code:baseline": "node scripts/check-dead-code.cjs --write",
