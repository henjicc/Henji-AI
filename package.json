{
  "name": "henji-ai",
  "private": true,
  "version": "2.0.0",
  "description": "一个聚合多家AI供应商，一站式生成图片、视频和音频的客户端",
  "author": "Henji AI",
  "main": "out/main/index.cjs",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run gen:progress-seeds && npm run gen:model-manifest && vite",
    "gen:progress-seeds": "node scripts/generate-progress-seeds.cjs",
    "gen:model-manifest": "node scripts/generate-model-manifest.cjs",
    "check:colors": "node scripts/check-color-tokens.cjs",
    "check:surface": "node scripts/check-surface-tokens.cjs",
    "check:surface:strict": "node scripts/check-surface-tokens.cjs --strict",
    "check:model-i18n": "node scripts/check-model-i18n.cjs",
    "logs:query": "node scripts/query-logs.cjs",
    "assistant:cli": "node scripts/run-assistant-cli.cjs",
    "build": "npm run gen:progress-seeds && npm run gen:model-manifest && npm run check:colors && npm run check:surface:strict && npm run check:icons:strict && npm run check:model-i18n && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:ui-inspection": "node --test scripts/lib/uiInspection.test.cjs",
    "test:assistant-persistence": "node scripts/test-assistant-persistence.cjs",
    "test:assistant-eval": "vitest run electron/main/services/agent-runtime/evaluation/minimal-evaluator.test.ts electron/main/services/agent-runtime/evaluation/regression-cases.test.ts electron/main/services/agent-runtime/runner/runner-canvas.test.ts electron/main/services/agent-runtime/runner/approval-waiter.test.ts electron/main/services/agent-runtime/runner/model-execution.test.ts electron/main/services/agent-runtime/runner/tool-call-scheduler.test.ts electron/main/services/agent-runtime/runner/result-verifier.test.ts electron/main/services/agent-runtime/runner/runner-results.test.ts electron/main/services/agent-runtime/runner/working-summary.test.ts electron/main/services/agent-runtime/runner/recovery-guard.test.ts electron/main/services/agent-runtime/runner/memory-context.test.ts electron/main/services/agent-runtime/context/context.test.ts electron/main/services/agent-runtime/context/compaction.test.ts electron/main/services/agent-runtime/context/catalog.test.ts electron/main/services/agent-runtime/tools/builtin/frontend-canvas.test.ts electron/main/services/assistant/memory-relevance.test.ts src/features/canvas/application/agentCanvasActions.test.ts src/features/assistant/conversation/agentRunReducer.test.ts src/features/assistant/conversation/AssistantMarkdown.test.tsx electron/main/services/agent-runtime/tools/gateway.test.ts electron/main/services/agent-runtime/diagnostics/query-diagnostic-events.test.ts",
    "lint:colors": "npm run check:colors",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "electron:dev": "npm run gen:progress-seeds && npm run gen:model-manifest && node scripts/electron-vite-dev.cjs",
    "electron:build": "npm run gen:progress-seeds && npm run gen:model-manifest && npm run check:colors && npm run check:surface:strict && npm run check:icons:strict && npm run check:model-i18n && tsc -p tsconfig.electron.json && electron-vite build",
    "electron:pack": "npm run electron:build && electron-builder --dir",
    "electron:dist": "npm run electron:build && electron-builder",
    "electron:publish": "npm run electron:build && electron-builder --publish always",
    "electron:smoke": "node scripts/electron-phase4-smoke.cjs",
    "electron:assistant-utility-smoke": "node scripts/run-agent-utility-smoke.cjs",
    "electron:canvas-stress": "node scripts/electron-phase4-canvas-stress.cjs",
    "electron:pan-bench": "node scripts/electron-canvas-pan-bench.cjs",
    "check:canvas-visual": "node scripts/electron-canvas-visual-check.cjs",
    "electron:dpi-check": "node scripts/electron-phase4-dpi-check.cjs",
    "electron:updater-e2e": "node scripts/electron-phase4-updater-e2e.cjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "release": "node scripts/release.cjs",
    "gen:camera-stage-poses": "node scripts/generate-camera-stage-poses.cjs",
    "ui:tour": "node scripts/ui-tour.cjs",
    "check:ui-visual": "node scripts/ui-visual-audit.cjs",
    "check:icons": "node scripts/check-icon-tokens.cjs",
    "check:icons:strict": "node scripts/check-icon-tokens.cjs --strict"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.62",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-document": "^3.28.0",
    "@tiptap/extension-hard-break": "^3.28.0",
    "@tiptap/extension-paragraph": "^3.28.0",
    "@tiptap/extension-text": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/suggestion": "^3.28.0",
    "@types/react-window": "^1.8.8",
    "@xyflow/react": "^12.10.1",
    "ai": "6.0.234",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.5.0",
    "dockview-react": "^7.0.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "i18next": "^23.7.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "konva": "^10.2.0",
    "lucide-react": "^0.562.0",
    "pica": "^9.0.1",
    "pinyin-match": "^1.2.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-image-crop": "^11.0.10",
    "react-konva": "^18.2.14",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.15.0",
    "react-window": "^2.2.3",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.2",
    "three": "^0.169.0",
    "three-stdlib": "^2.36.1",
    "uuid": "^13.0.0",
    "yauzl": "^3.4.0",
    "zod": "4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pica": "^9.0.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/three": "^0.169.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^1.6.1"
  }
}
