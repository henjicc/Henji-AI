    "check:assistant-capabilities": "npm run check:assistant-capabilities:structure && npm run check:application-control-coverage && npm run check:application-control-invariants",
    "logs:query": "node scripts/query-logs.cjs",
    "assistant:cli": "node scripts/run-assistant-cli.cjs",
    "build": "npm run gen:progress-seeds && npm run check:colors && npm run check:surface:strict && npm run check:icons:strict && npm run check:ui-residue && npm run check:model-i18n && npm run check:assistant-capabilities && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --cache --cache-location node_modules/.eslintcache --report-unused-disable-directives --max-warnings 0",
    "lint:electron": "eslint electron --ext ts --cache --cache-location node_modules/.eslintcache-electron --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --mode unit",
    "test:gpu": "vitest run --mode gpu",
    "test:image-export": "vitest run --mode image-export",
    "test:ffmpeg-cli": "vitest run --mode ffmpeg-cli",
    "test:suites": "node --test scripts/lib/testSuites.test.cjs",
    "verify:changed": "node scripts/run-changed-verification.cjs",
    "test:ui-inspection": "node --test scripts/lib/uiInspection.test.cjs scripts/lib/uiContrastAudit.test.cjs scripts/lib/runtimeEvidence.test.cjs scripts/lib/realityTestPlan.test.cjs scripts/lib/canvasVisualDiff.test.cjs scripts/lib/uiReviewSteps.test.cjs scripts/lib/uiReviewMetrics.test.cjs scripts/lib/uiResidueRules.test.cjs scripts/lib/undefinedColorClasses.test.cjs scripts/lib/uiInspectionCompositedMove.test.cjs scripts/lib/uiReviewSummary.test.cjs scripts/lib/uiInspectionSceneHelpers.test.cjs",
