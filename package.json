    "test:reality": "node scripts/run-reality-tests.cjs",
    "test:assistant-persistence": "node scripts/test-assistant-persistence.cjs",
    "test:assistant-model-compat": "vitest run packages/ai-sdk/tests/llm/sdk/model-step.test.ts packages/ai-sdk/tests/llm/sdk/provider-error.test.ts packages/ai-sdk/tests/llm/sdk/provider-adapter.test.ts packages/ai-sdk/tests/llm/sdk/retry-policy.test.ts electron/main/services/llm/sdk/scripted-model-step.test.ts electron/main/services/llm/sdk/trace.test.ts src/services/llm/LlmConfigService.test.ts",
    "test:assistant-production": "node scripts/run-assistant-production-tests.cjs",
    "lint:colors": "npm run check:colors",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "electron:dev": "npm run prepare:media-binaries && npm run gen:progress-seeds && npm run gen:licenses && node scripts/electron-vite-dev.cjs",
    "electron:bundle": "node scripts/run-electron-bundle.cjs",
    "electron:build": "npm run prepare:media-binaries && npm run gen:progress-seeds && npm run gen:catalog && npm run build:audio-worker && npm run build:video-decoder && npm run gen:licenses -- --strict && npm run check:colors && npm run check:surface:strict && npm run check:icons:strict && npm run check:ui-residue && npm run check:model-i18n && npm run check:main-imports && npm run check:sdk && npm run check:assistant-capabilities && npm run build:sdk && tsc -p tsconfig.electron.json && electron-vite build",
    "electron:pack": "npm run electron:build && electron-builder --dir",
    "electron:dist": "npm run electron:build && electron-builder",
    "electron:publish": "npm run electron:build && electron-builder --publish always",
    "electron:smoke": "node scripts/electron-phase4-smoke.cjs",
    "electron:canvas-stress": "node scripts/electron-phase4-canvas-stress.cjs",
    "electron:pan-bench": "node scripts/electron-canvas-pan-bench.cjs",
    "electron:media-import-bench": "node scripts/electron-media-import-bench.cjs",
    "image-editor:v3:perf": "vite-node scripts/image-editor-v3-performance-bench.ts",
    "image-editor:v3:perf:real": "node --expose-gc node_modules/vite-node/vite-node.mjs scripts/image-editor-v3-real-performance-bench.ts",
    "image-editor:v3:gpu-baseline": "vite-node scripts/image-editor-v3-gpu-baseline.ts",
    "check:canvas-visual": "node scripts/electron-canvas-visual-check.cjs",
    "electron:dpi-check": "node scripts/electron-phase4-dpi-check.cjs",
    "electron:updater-e2e": "node scripts/electron-phase4-updater-e2e.cjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "release": "node scripts/release.cjs",
    "publish:sdk": "npm publish -w packages/ai-sdk --registry=https://registry.npmjs.org/ --access public",
    "gen:camera-stage-poses": "node scripts/generate-camera-stage-poses.cjs",
    "ui:tour": "node scripts/ui-tour.cjs",
    "ui:residue": "node scripts/ui-residue-scan.cjs",
    "check:ui-visual": "node scripts/ui-visual-audit.cjs",
    "test:ui-visual-rules": "node scripts/ui-visual-rule-samples.cjs",
    "check:icons": "node scripts/check-icon-tokens.cjs",
    "check:icons:strict": "node scripts/check-icon-tokens.cjs --strict",
    "llm:verify": "node scripts/verify-llm-model.cjs",
    "test:application-harness": "vitest run src/tests/applicationHarness.cameraStageRender.test.ts src/tests/applicationHarness.canvas.test.ts src/tests/applicationHarness.canvasPersistence.test.ts src/tests/applicationHarness.imageEditPersistence.test.ts src/tests/applicationHarness.close.test.ts src/tests/applicationHarness.imageDocumentProject.test.ts src/tests/applicationHarness.unopenedImageDocument.test.ts src/tests/applicationHarness.resourceCatalog.test.ts src/tests/applicationHarness.rejection.test.ts src/tests/applicationHarness.transactionReliability.test.ts src/tests/applicationHarness.writeLoop.test.ts src/tests/harnessNativeStorage.test.ts src/features/application-control/hostContext/hostScopeCoverage.test.ts",
    "test:embedded-agent": "vitest run electron/main/services/embedded-agent/attachments.test.ts electron/main/services/embedded-agent/messagePresentation.test.ts electron/main/services/embedded-agent/models.test.ts electron/main/services/embedded-agent/piEngine.test.ts electron/main/services/embedded-agent/service.test.ts electron/main/services/embedded-agent/servicePi.test.ts electron/main/services/embedded-agent/skills.test.ts electron/main/services/embedded-agent/toolResult.test.ts electron/main/assistant-cli/arguments.test.ts electron/main/assistant-cli/embedded-runner.test.ts"
  },
