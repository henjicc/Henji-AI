nner/runner-compaction.test.ts src/core/assistant/applicationCapabilities.test.ts src/core/assistant/hostContracts.test.ts src/core/assistant/runtimeContracts.test.ts src/core/assistant/contextProjection.test.ts src/features/assistant/applicationCapabilities/registry.test.ts src/features/canvas/application/canvasApplicationService.test.ts src/features/assistant/conversation/agentRunReducer.test.ts src/features/assistant/conversation/AssistantMarkdown.test.tsx src/features/assistant/hooks/agentEventRecovery.test.ts electron/main/services/agent-runtime/tools/approval-policy.test.ts electron/main/services/agent-runtime/tools/approval.test.ts electron/main/services/agent-runtime/tools/gateway.test.ts electron/main/services/agent-runtime/tools/gateway-audit.test.ts electron/main/services/agent-runtime/diagnostics/query-diagnostic-events.test.ts",
